{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Roundtable",
  "version": "0.1.0",
  "identifier": "app.roundtable.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Roundtable",
        "width": 1280,
        "height": 720,
        "minWidth": 360,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://github.com/yashu2733537/roundtable/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1MTIzNzEzRDU4NzQyMEUKUldRT1FvZlZFemNTWmN5UmtSRGJIMm5TYlRGTnJIZ00zcWdiVllEWVlHSFYyb2kzV2tFWDIwMlkK"
    }
  }
}
